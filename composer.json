{
    "name": "liya/mathdeck",
    "description": "Deterministic, event-sourced rules engine for a turn-based educational mathematics card game.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "opis/json-schema": "^2.3",
        "php-di/php-di": "^7.0",
        "slim/psr7": "^1.6",
        "slim/slim": "^4.12"
    },
    "require-dev": {
        "infection/infection": "^0.29",
        "league/openapi-psr7-validator": "^0.22",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.0",
        "qossmic/deptrac": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "MathDeck\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MathDeck\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "coverage": "XDEBUG_MODE=coverage phpunit --coverage-text --coverage-html coverage",
        "deptrac": "deptrac analyse --no-progress"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    }
}
