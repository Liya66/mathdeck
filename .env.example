# Copy to .env on the server and fill in. .env is gitignored — none of these
# values belongs in the repository, and the development ones in
# docker-compose.yml are published, so they are not secrets at all.

# The hostname Caddy will obtain a certificate for. Use `:80` to test without TLS.
SITE_ADDRESS=mathdeck.example.com

# openssl rand -hex 32
MATCHDECK_TOKEN_SECRET=

# openssl rand -base64 24
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
